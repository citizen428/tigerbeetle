<suites>
  <item>
    <suite>create_accounts</suite>
    <cases>
      <item>
        <description>creates an account</description>
        <act>
          <item>
            <operation>
              <name>create_accounts</name>
              <inputs>
                <item>
                  <value>
                    <account>
                      <id>
                        <id>1</id>
                      </id>
                      <ledger>1</ledger>
                      <code>1</code>
                    </account>
                  </value>
                </item>
              </inputs>
            </operation>
          </item>
        </act>
        <assert>
          <item>
            <assert_equal>
              <actual>create_account_results</actual>
              <expected>
                <item>
                  <status>created</status>
                </item>
              </expected>
            </assert_equal>
          </item>
        </assert>
      </item>
      <item>
        <description>returns exists for a duplicate account</description>
        <arrange>
          <item>
            <assign>
              <name>account</name>
              <value>
                <account>
                  <id>
                    <id>1</id>
                  </id>
                  <ledger>1</ledger>
                  <code>1</code>
                </account>
              </value>
            </assign>
          </item>
          <item>
            <operation>
              <name>create_accounts</name>
              <inputs>
                <item>
                  <from>account</from>
                </item>
              </inputs>
            </operation>
          </item>
        </arrange>
        <act>
          <item>
            <operation>
              <name>create_accounts</name>
              <inputs>
                <item>
                  <from>account</from>
                </item>
              </inputs>
            </operation>
          </item>
        </act>
        <assert>
          <item>
            <assert_equal>
              <actual>create_account_results</actual>
              <expected>
                <item>
                  <status>exists</status>
                </item>
              </expected>
            </assert_equal>
          </item>
        </assert>
      </item>
    </cases>
  </item>
  <item>
    <suite>lookup_accounts</suite>
    <cases>
      <item>
        <description>returns an existing account</description>
        <arrange>
          <item>
            <operation>
              <name>create_accounts</name>
              <inputs>
                <item>
                  <value>
                    <account>
                      <id>
                        <id>1</id>
                      </id>
                      <ledger>1</ledger>
                      <code>1</code>
                    </account>
                  </value>
                </item>
              </inputs>
            </operation>
          </item>
        </arrange>
        <act>
          <item>
            <operation>
              <name>lookup_accounts</name>
              <inputs>
                <item>
                  <value>
                    <id>1</id>
                  </value>
                </item>
              </inputs>
            </operation>
          </item>
        </act>
        <assert>
          <item>
            <assert_equal>
              <actual>accounts</actual>
              <expected>
                <item>
                  <id>
                    <id>1</id>
                  </id>
                  <ledger>1</ledger>
                  <code>1</code>
                </item>
              </expected>
            </assert_equal>
          </item>
        </assert>
      </item>
      <item>
        <description>returns no accounts for a missing id</description>
        <act>
          <item>
            <operation>
              <name>lookup_accounts</name>
              <inputs>
                <item>
                  <value>
                    <id>1</id>
                  </value>
                </item>
              </inputs>
            </operation>
          </item>
        </act>
        <assert>
          <item>
            <assert_empty>accounts</assert_empty>
          </item>
        </assert>
      </item>
    </cases>
  </item>
