<suites>
  <item>
    <suite>get_account_balances</suite>
    <cases>
      <item>
        <description>returns a balance per transfer for a history account</description>
        <arrange>
          <item>
            <operation>
              <name>create_accounts</name>
              <inputs>
                <item>
                  <value>
                    <account>
                      <id>
                        <id>1</id>
                      </id>
                      <ledger>1</ledger>
                      <code>1</code>
                      <flags>
                        <item>history</item>
                      </flags>
                    </account>
                  </value>
                </item>
                <item>
                  <value>
                    <account>
                      <id>
                        <id>2</id>
                      </id>
                      <ledger>1</ledger>
                      <code>1</code>
                    </account>
                  </value>
                </item>
              </inputs>
            </operation>
          </item>
          <item>
            <operation>
              <name>create_transfers</name>
              <inputs>
                <item>
                  <value>
                    <transfer>
                      <id>
                        <id>3</id>
                      </id>
                      <debit_account_id>
                        <id>1</id>
                      </debit_account_id>
                      <credit_account_id>
                        <id>2</id>
                      </credit_account_id>
                      <amount>10</amount>
                      <ledger>1</ledger>
                      <code>1</code>
                    </transfer>
                  </value>
                </item>
                <item>
                  <value>
                    <transfer>
                      <id>
                        <id>4</id>
                      </id>
                      <debit_account_id>
                        <id>2</id>
                      </debit_account_id>
                      <credit_account_id>
                        <id>1</id>
                      </credit_account_id>
                      <amount>20</amount>
                      <ledger>1</ledger>
                      <code>1</code>
                    </transfer>
                  </value>
                </item>
              </inputs>
            </operation>
          </item>
        </arrange>
        <act>
          <item>
            <operation>
              <name>get_account_balances</name>
              <inputs>
                <item>
                  <value>
                    <account_filter>
                      <account_id>
                        <id>1</id>
                      </account_id>
                      <limit>10</limit>
                      <flags>
                        <item>debits</item>
                        <item>credits</item>
                      </flags>
                    </account_filter>
                  </value>
                </item>
              </inputs>
            </operation>
          </item>
        </act>
        <assert>
          <item>
            <assert_equal>
              <actual>account_balances</actual>
              <expected>
                <item>
                  <debits_posted>10</debits_posted>
                  <credits_posted>0</credits_posted>
                </item>
                <item>
                  <debits_posted>10</debits_posted>
                  <credits_posted>20</credits_posted>
                </item>
              </expected>
            </assert_equal>
          </item>
        </assert>
      </item>
      <item>
        <description>returns no balances without the history flag</description>
        <arrange>
          <item>
            <operation>
              <name>create_accounts</name>
