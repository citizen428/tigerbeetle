.{
    .suite = .lookup_transfers,
    .cases = .{
        .{
            .description = "returns an existing transfer",
            .arrange = .{
                .{ .assign = .{ .name = "transfer_id", .value = .new_id } },
                .{ .assign = .{ .name = "debit_account_id", .value = .new_id } },
                .{ .assign = .{ .name = "credit_account_id", .value = .new_id } },
                .{
                    .operation = .{
                        .name = .create_accounts,
                        .inputs = .{
                            .{ .value = .{ .account = .{
                                .id = .{ .from = "debit_account_id" },
                                .ledger = 1,
                                .code = 1,
                            } } },
                            .{ .value = .{ .account = .{
                                .id = .{ .from = "credit_account_id" },
                                .ledger = 1,
                                .code = 1,
                            } } },
                        },
                    },
                },
                .{
                    .operation = .{
                        .name = .create_transfers,
                        .inputs = .{
                            .{ .value = .{ .transfer = .{
                                .id = .{ .from = "transfer_id" },
                                .debit_account_id = .{ .from = "debit_account_id" },
                                .credit_account_id = .{ .from = "credit_account_id" },
                                .amount = 42,
                                .ledger = 1,
                                .code = 1,
                            } } },
                        },
                    },
                },
            },
            .act = .{
                .{
                    .operation = .{
                        .name = .lookup_transfers,
                        .inputs = .{.{ .from = "transfer_id" }},
                    },
                },
            },
            .assert = .{
                .{ .assert_equal = .{
                    .transfers = .{.{
                        .id = .{ .from = "transfer_id" },
                        .debit_account_id = .{ .from = "debit_account_id" },
                        .credit_account_id = .{ .from = "credit_account_id" },
                        .amount = 42,
                    }},
                } },
            },
        },
        .{
            .description = "returns no transfers for a missing id",
            .act = .{
                .{
                    .operation = .{
                        .name = .lookup_transfers,
                        .inputs = .{.{ .value = .new_id }},
                    },
                },
            },
            .assert = .{
                .{ .assert_empty = .transfers },
            },
        },
    },
}
