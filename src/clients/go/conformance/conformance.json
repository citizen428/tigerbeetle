{
  "suites": [
    {
      "suite": "create_accounts",
      "cases": [
        {
          "description": "creates an account",
          "act": [
            {
              "operation": {
                "name": "create_accounts",
                "inputs": [
                  {
                    "value": {
                      "account": {
                        "id": {
                          "id": 1
                        },
                        "ledger": 1,
                        "code": 1
                      }
                    }
                  }
                ]
              }
            }
          ],
          "assert": [
            {
              "assert_equal": {
                "actual": "create_account_results",
                "expected": [
                  {
                    "status": "created"
                  }
                ]
              }
            }
          ]
        },
        {
          "description": "returns exists for a duplicate account",
          "arrange": [
            {
              "assign": {
                "name": "account",
                "value": {
                  "account": {
                    "id": {
                      "id": 1
                    },
                    "ledger": 1,
                    "code": 1
                  }
                }
              }
            },
            {
              "operation": {
                "name": "create_accounts",
                "inputs": [
                  {
                    "from": "account"
                  }
                ]
              }
            }
          ],
          "act": [
            {
              "operation": {
                "name": "create_accounts",
                "inputs": [
                  {
                    "from": "account"
                  }
                ]
              }
            }
          ],
          "assert": [
            {
              "assert_equal": {
                "actual": "create_account_results",
                "expected": [
                  {
                    "status": "exists"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "suite": "lookup_accounts",
      "cases": [
        {
          "description": "returns an existing account",
          "arrange": [
            {
              "operation": {
                "name": "create_accounts",
                "inputs": [
                  {
                    "value": {
                      "account": {
                        "id": {
                          "id": 1
                        },
                        "ledger": 1,
                        "code": 1
                      }
                    }
                  }
                ]
              }
            }
          ],
          "act": [
            {
              "operation": {
                "name": "lookup_accounts",
                "inputs": [
                  {
                    "value": {
                      "id": 1
                    }
                  }
                ]
              }
            }
          ],
          "assert": [
            {
              "assert_equal": {
                "actual": "accounts",
                "expected": [
                  {
                    "id": {
                      "id": 1
                    },
                    "ledger": 1,
                    "code": 1
                  }
                ]
              }
            }
          ]
        },
        {
          "description": "returns no accounts for a missing id",
          "act": [
            {
              "operation": {
                "name": "lookup_accounts",
                "inputs": [
                  {
                    "value": {
                      "id": 1
                    }
                  }
                ]
              }
            }
          ],
          "assert": [
            {
              "assert_empty": "accounts"
            }
          ]
        }
      ]
    },
    {
      "suite": "uint128_range",
      "cases": [
        {
          "description": "accepts the maximum u128",
          "arrange": [
            {
              "assign": {
                "name": "uint128_max",
                "value": {
                  "u128": "340282366920938463463374607431768211455"
                }
              }
            }
          ],
          "act": [
            {
              "operation": {
                "name": "lookup_accounts",
                "inputs": [
                  {
                    "from": "uint128_max"
                  }
                ]
              }
            }
          ],
          "assert": [
            {
              "assert_empty": "accounts"
            }
          ]
        },
        {
          "description": "rejects a u128 above the maximum",
          "act": [
            {
              "operation": {
                "name": "lookup_accounts",
                "inputs": [
                  {
                    "value": {
                      "u128": "340282366920938463463374607431768211456"
                    }
                  }
                ]
              }
            }
          ],
          "assert": [
            {
              "assert_fail": true
            }
          ]
        }
      ]
    }
  ]
}
